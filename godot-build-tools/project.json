{
  "name": "godot-build-tools",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "sourceRoot": ".",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist",
        "main": "index.ts",
        "tsConfig": "tsconfig.lib.json",
        "assets": ["*.md"]
      }
    }
  },
  "tags": []
}
