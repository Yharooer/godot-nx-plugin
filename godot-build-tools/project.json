{
  "name": "godot-build-tools",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "godot-build-tools/lib",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{projectRoot}/build"
      ],
      "options": {
        "outputPath": "godot-build-tools/build",
        "main": "godot-build-tools/lib/index.ts",
        "tsConfig": "godot-build-tools/tsconfig.json",
        "assets": [
          "godot-build-tools/*.md",
          "godot-build-tools/executors.json",
          "godot-build-tools/package.json"
        ]
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf godot-build-tools/build"
      }
    }
  },
  "tags": [
    "build-tools"
  ]
}