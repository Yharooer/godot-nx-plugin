{
  "$schema": "http://json-schema.org/schema",
  "version": 2,
  "title": "GDExtension Build Executor",
  "description": "Build a GDExtension project (C++/Rust)",
  "type": "object",
  "properties": {
    "skipDependencyValidation": {
      "type": "boolean",
      "description": "Skip dependency validation (useful for development)",
      "default": false
    },
    "verbose": {
      "type": "boolean",
      "description": "Enable verbose logging",
      "default": false
    },
    "cleanBuild": {
      "type": "boolean",
      "description": "Clean the build directory before building",
      "default": true
    },
    "targets": {
      "type": "array",
      "description": "Build targets (debug, release, or both)",
      "items": {
        "type": "string",
        "enum": ["debug", "release"]
      },
      "default": ["debug", "release"]
    },
    "platforms": {
      "type": "array",
      "description": "Platform targets to build for",
      "items": {
        "type": "string",
        "pattern": "^(windows|macos|linux|android|ios|web)\\.(x86_64|arm64|universal|wasm32|rv64)$"
      },
      "default": ["macos.universal"]
    },
    "compatibilityMinimum": {
      "type": "string",
      "description": "Godot compatibility minimum version",
      "pattern": "^\\d+\\.\\d+$",
      "default": "4.1"
    },
    "reloadable": {
      "type": "boolean",
      "description": "Whether the extension should be reloadable",
      "default": true
    },
    "entrySymbol": {
      "type": "string",
      "description": "Entry symbol for the GDExtension (auto-generated if not specified)"
    },
    "linkType": {
      "type": "string",
      "description": "Dynamic linking options where possible",
      "enum": ["static", "dynamic"],
      "default": "dynamic"
    }
  },
  "additionalProperties": false
}