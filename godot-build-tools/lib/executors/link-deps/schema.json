{
  "$schema": "http://json-schema.org/schema",
  "version": 2,
  "title": "Link Dependencies Executor",
  "description": "Link project dependencies to _addons directory",
  "type": "object",
  "properties": {
    "skipDependencyValidation": {
      "type": "boolean",
      "description": "Skip dependency validation (useful for development)",
      "default": false
    },
    "verbose": {
      "type": "boolean",
      "description": "Enable verbose logging",
      "default": false
    },
    "cleanBuild": {
      "type": "boolean",
      "description": "Clean the _addons directory before linking",
      "default": true
    }
  },
  "additionalProperties": false
}