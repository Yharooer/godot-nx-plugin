{
  "name": "@yharooer/godot-build-tools",
  "version": "0.1.0",
  "description": "NX build tools for Godot projects",
  "main": "build/lib/index.js",
  "types": "build/lib/index.d.ts",
  "executors": "./executors.json",
  "files": [
    "build",
    "executors.json"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@nx/devkit": "^21.3.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "nx": ">=21.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}