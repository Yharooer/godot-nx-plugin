{
  "name": "godot-nx-plugin",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "nx": "nx",
    "build": "nx run-many --target=build --all",
    "build:godot-build-tools": "nx run godot-build-tools:build",
    "build:character-common": "nx run character-common:build",
    "build:character-gdscript": "nx run character-gdscript:build",
