    "@swc/helpers": "^0.5.17",
    "@types/node": "^20.0.0",
    "nx": "21.3.7",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@yharooer/godot-build-tools": "file:godot-build-tools"
  }
}
